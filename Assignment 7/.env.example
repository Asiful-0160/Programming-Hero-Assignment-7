# Run npm run auth:setup to create .env.local with a random secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=.data/auth.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Empty locally to use SQLite; set a hosted PostgreSQL URL for Vercel.
DATABASE_URL=
